{
    "name": "runstorm",
    "version": "0.1.1",
    "description": "Easily run multiple commands in parallel threads.",
    "keywords": [
        "parallel",
        "execution",
        "worker",
        "thread",
        "shell"
    ],
    "homepage": "https://github.com/electrovir/runstorm",
    "bugs": {
        "url": "https://github.com/electrovir/runstorm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/runstorm.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": "dist/cli/cli.script.js",
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "tsx src/manual-test.script.mock.ts",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,docs,deps,lint \"npm run test:coverage\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.32.2",
        "@augment-vir/common": "^31.32.2",
        "@augment-vir/node": "^31.32.2",
        "ansi-styles": "^6.2.1",
        "cli-vir": "^0.1.0",
        "object-shape-tester": "^5.3.0",
        "type-fest": "^4.41.0",
        "typed-event-target": "^4.1.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.32.2",
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.33.0",
        "@stylistic/eslint-plugin": "^5.2.3",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^24.2.1",
        "@typescript-eslint/eslint-plugin": "^8.39.0",
        "c8": "^10.1.3",
        "cspell": "^9.2.0",
        "dependency-cruiser": "^17.0.1",
        "esbuild": "^0.25.8",
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^52.0.4",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.2",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.4",
        "eslint-plugin-unicorn": "~57.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^18.0.2",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.3",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.2.0",
        "prettier-plugin-packagejson": "^2.5.19",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "typedoc": "^0.28.10",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0",
        "virmator": "^13.16.1"
    },
    "engines": {
        "node": ">=22"
    }
}

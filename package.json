{
    "name": "runstorm",
    "version": "1.1.0",
    "description": "Easily run multiple commands in parallel threads.",
    "keywords": [
        "parallel",
        "execution",
        "worker",
        "thread",
        "shell"
    ],
    "homepage": "https://github.com/electrovir/runstorm",
    "bugs": {
        "url": "https://github.com/electrovir/runstorm/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/runstorm.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "runstorm": "dist/cli/cli.script.js"
    },
    "scripts": {
        "compile": "virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "tsx src/manual-test.script.mock.ts",
        "test": "virmator test node",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names spelling,format,docs,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\" && npm run test:coverage",
        "test:coverage": "npm run test coverage",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "npm run test update"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/node": "^32.2.1",
        "ansi-styles": "^6.2.3",
        "cli-vir": "^1.0.3",
        "object-shape-tester": "^6.14.1",
        "typed-event-target": "^4.3.2"
    },
    "devDependencies": {
        "@augment-vir/test": "^32.2.1",
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "c8": "^12.0.0",
        "concurrently": "^10.0.3",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "~72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^22.2.9",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "8.65.0",
        "virmator": "^14.30.0"
    },
    "engines": {
        "node": ">=22"
    }
}
